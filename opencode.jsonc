{
    "$schema": "https://opencode.ai/config.json",

    "mcp": {
        "brave-search": {
            "type": "local",
            "command": ["mcp-server-brave-search"],
        },

        "gitmcp": {
            "type": "local",
            "command": ["mcp-remote", "https://gitmcp.io/docs"],
        },

        "serena": {
            "type": "local",
            "command": ["serena", "start-mcp-server"],
        },

        "sequential-thinking": {
            "type": "local",
            "command": ["bun", "run", "mcp-server-sequential-thinking"],
        },
    },
}
